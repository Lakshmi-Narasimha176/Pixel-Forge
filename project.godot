; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be also edited by hand.

config_version=5

[application]

config/name="THE LAST REVENGE"
config/description="First-person supernatural horror adventure game"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.04, 0.03, 0.04, 1)
config/icon="res://PSX_Anomaly_Horror_Modular_Kit_Free_Sampler/Godot/icon.png"

[autoload]

GameManager="*res://autoload/game_manager.gd"
ObjectiveManager="*res://autoload/objective_manager.gd"
SaveSystem="*res://autoload/save_system.gd"
SoundManager="*res://autoload/sound_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[importer_defaults]

scene={
"gltf/embedded_image_handling": 3,
"meshes/generate_lods": false
}
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

