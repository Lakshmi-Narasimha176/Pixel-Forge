; THE LAST REVENGE - Godot 4.3 horror game built from the Pixel-Forge assets.
; Open this folder in Godot 4.3+ (run `git lfs pull` first so the .glb files are real), press F5.
config_version=5

[application]

config/name="The Last Revenge"
config/description="First-person survival horror in the Hollis house, built from the Pixel-Forge GLB assets."
run/main_scene="res://horror/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.02, 0.025, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[importer_defaults]

scene={
"meshes/create_shadow_meshes": false,
"meshes/generate_lods": false
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
