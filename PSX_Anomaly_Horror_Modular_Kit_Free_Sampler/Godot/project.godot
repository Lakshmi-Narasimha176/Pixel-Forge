; PSX Anomaly Horror Modular Kit - Free Sampler - Godot 4.3 project - bitkiln - https://bitkiln.itch.io
; Open this file with Godot 4.3 or newer and press F5: the anomaly loop built from kit pieces (Tab: the showcase of
; every piece). The [importer_defaults] below keep the textures lossless, uncompressed and without mipmaps: copy that
; block into your own project.godot before you add the kit (see README_GODOT.md).

config_version=5

[application]

config/name="PSX Anomaly Horror Modular Kit - Free Sampler"
config/description="Free sampler of the PSX Anomaly Horror Modular Kit: the loop hallway of the house and a playable anomaly loop."
run/main_scene="res://demo/loop_house.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.078, 0.063, 0.071, 1)
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[importer_defaults]

scene={
"gltf/embedded_image_handling": 3,
"meshes/generate_lods": false
}
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_renderable_lights=64
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0.02, 0.022, 0.03, 1)
